{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "/tmp/tdg-tests",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "../lib/server/**/*.ts",
    "../lib/catalog.ts",
    "../lib/blog.ts",
    "../lib/asset.ts"
  ]
}
